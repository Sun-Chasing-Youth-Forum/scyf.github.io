---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { findNextEvent, formatDate } from '../utils/events';
import { sitePath } from '../utils/paths';
import EventCard from '../components/EventCard.astro';

const events = await getCollection('events');
const nextEvent = findNextEvent(events);
const recentEvents = [...events]
  .filter((event) => event.data.status === '已结束')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const quickLinks = [
  ['活动日程', '查看下一期及未来活动安排', '/events/'],
  ['论坛手册', '查阅组织说明与报告人指南', '/handbook/'],
  ['培训资料', '浏览数据、软件与分析教程', '/training/'],
  ['讨论区', '参与科学问题与合作交流', '/discussion/']
];
---

<BaseLayout>
  <section class="intro-band">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">太阳物理 · 青年学者 · 开放交流</p>
        <h1>逐日青年论坛</h1>
        <p class="lead">连接太阳物理领域的青年科研人员，分享新发现、新方法与开放问题。</p>
      </div>
      <p class="intro-note">论坛原则上每两周举办一次，欢迎青年科研人员、博士后与研究生参与报告和讨论。</p>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div><p class="eyebrow">NEXT SESSION</p><h2>下一期活动</h2></div>
      <a class="text-link" href={sitePath('/events/')}>查看完整日程 →</a>
    </div>
    {nextEvent ? (
      <article class="featured-event">
        <div class="issue-block"><span>第</span><strong>{String(nextEvent.data.issue).padStart(2, '0')}</strong><span>期</span></div>
        <div class="featured-main">
          <p class="event-date">{formatDate(nextEvent.data.date)} · {nextEvent.data.time}</p>
          <h3>{nextEvent.data.title || '报告题目待更新'}</h3>
          <dl class="event-meta">
            <div><dt>主持人</dt><dd>{nextEvent.data.host}</dd></div>
            <div><dt>报告人</dt><dd>{nextEvent.data.speaker || '待定'}</dd></div>
            <div><dt>单位</dt><dd>{nextEvent.data.affiliation || '待定'}</dd></div>
            <div><dt>地点</dt><dd>{nextEvent.data.location}</dd></div>
          </dl>
          <a class="button" href={sitePath(`/events/${nextEvent.id}/`)}>查看活动详情</a>
        </div>
      </article>
    ) : (
      <div class="empty-state"><h3>新一期活动正在筹备</h3><p>日程确定后将在这里第一时间公布。</p></div>
    )}
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">QUICK ACCESS</p><h2>快速入口</h2></div></div>
      <div class="quick-grid">
        {quickLinks.map(([title, description, href], index) => (
          <a class="quick-card" href={sitePath(href)}>
            <span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section container two-column">
    <div>
      <div class="section-heading"><div><p class="eyebrow">RECENT</p><h2>最近活动</h2></div><a class="text-link" href={sitePath('/archive/')}>全部往期 →</a></div>
      <div class="stack-list">
        {recentEvents.length ? recentEvents.map((event) => <EventCard event={event} compact />) : <p class="muted">暂无往期活动。</p>}
      </div>
    </div>
    <aside>
      <div class="section-heading"><div><p class="eyebrow">NEWS</p><h2>最新通知</h2></div></div>
      <div class="news-list">
        {news.map((item) => (
          <article>
            <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date, { weekday: undefined })}</time>
            <h3>{item.data.title}</h3><p>{item.data.summary}</p>
          </article>
        ))}
      </div>
    </aside>
  </section>
</BaseLayout>
