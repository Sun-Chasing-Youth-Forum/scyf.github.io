---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Giscus from '../../components/Giscus.astro';
import { formatDate } from '../../utils/events';
import { sitePath } from '../../utils/paths';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

interface Props { event: CollectionEntry<'events'>; }
const { event } = Astro.props;
const { Content } = await render(event);
const display = (value?: string) => value || '待定';
const sessions = event.data.sessions.length ? event.data.sessions : [{
  speaker: display(event.data.speaker),
  affiliation: display(event.data.affiliation),
  time: undefined,
  type: event.data.reportType,
  title: display(event.data.title),
  summary: event.data.summary
}];
---
<BaseLayout title={`第 ${event.data.issue} 期活动`} description={event.data.summary || '逐日青年论坛活动详情。'}>
  <article>
    <header class="event-detail-header">
      <div class="container narrow">
        <a class="breadcrumb" href={sitePath('/events/')}>活动日程</a>
        <div class="detail-kicker"><span>第 {event.data.issue} 期</span><StatusBadge status={event.data.status} /></div>
        <h1>{display(event.data.title)}</h1>
        <p>{formatDate(event.data.date)} · {event.data.time}</p>
      </div>
    </header>
    <div class="section container narrow detail-layout">
      <div class="detail-main">
        <section>
          <h2>活动信息</h2>
          <dl class="detail-meta">
            <div><dt>主持人</dt><dd>{event.data.host}</dd></div>
            <div><dt>报告人</dt><dd>{sessions.map((session) => session.speaker).join('、')}</dd></div>
            <div><dt>报告人单位</dt><dd>{[...new Set(sessions.map((session) => session.affiliation).filter(Boolean))].join('、') || '待定'}</dd></div>
            {event.data.reportType && <div><dt>报告类型</dt><dd>{event.data.reportType}</dd></div>}
            <div><dt>地点</dt><dd>{event.data.location}</dd></div>
            {event.data.meetingNumber && event.data.status !== '已结束' && <div><dt>腾讯会议号</dt><dd>{event.data.meetingNumber}</dd></div>}
          </dl>
          {event.data.meetingUrl && event.data.status !== '已结束' && <a class="button" href={event.data.meetingUrl}>进入线上会议</a>}
        </section>
        <section>
          <h2>{sessions.length > 1 ? '本期报告' : '报告信息'}</h2>
          <div class="session-list">
            {sessions.map((session, index) => (
              <article class="session-item">
                {sessions.length > 1 && <p class="session-number">报告 {index + 1}</p>}
                <div class="session-heading"><h3>{session.title}</h3>{session.type && <span>{session.type}</span>}</div>
                {session.time && <p class="session-time">{session.time}</p>}
                <p class="session-speaker">{session.speaker}{session.affiliation && session.affiliation !== '待定' ? ` · ${session.affiliation}` : ''}</p>
                <p>{session.summary || '摘要待更新。'}</p>
              </article>
            ))}
          </div>
        </section>
        <section class="prose"><Content /></section>
        <section>
          <h2>相关资料</h2>
          {event.data.materials.length ? (
            <ul class="resource-list">{event.data.materials.map((item) => <li><a href={item.url.startsWith('/') ? sitePath(item.url) : item.url}>{item.label}</a></li>)}</ul>
          ) : <p class="muted">本期暂未发布相关资料。</p>}
        </section>
        <Giscus />
      </div>
    </div>
  </article>
</BaseLayout>
