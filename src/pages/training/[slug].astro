---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../utils/paths';

export async function getStaticPaths() {
  const entries = await getCollection('training');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'training'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <header class="page-header article-header"><div class="container reading-width"><a class="breadcrumb" href={sitePath('/training/')}>培训资料</a><p class="eyebrow">{entry.data.category}</p><h1>{entry.data.title}</h1><p>{entry.data.summary}</p></div></header>
  <article class="section container reading-width prose">
    <Content />
    {entry.data.resources.length > 0 && <><h2>相关资源</h2><ul class="resource-list">{entry.data.resources.map((resource) => <li><span>{resource.type}</span><a href={resource.url.startsWith('/') ? sitePath(resource.url) : resource.url}>{resource.label}</a></li>)}</ul></>}
  </article>
</BaseLayout>
