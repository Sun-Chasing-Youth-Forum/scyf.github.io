---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { community } from '../config/community';

const categories = ['论坛公告', '报告主题建议', '太阳物理科学讨论', '数据需求', '数据分析与软件', '培训需求', '合作交流', '论坛意见与建议'];
---
<BaseLayout title="讨论交流" description="逐日青年论坛 GitHub Discussions 讨论区入口。">
  <PageHeader eyebrow="COMMUNITY" title="讨论交流" intro="围绕报告主题、科学问题、数据软件与合作需求持续交流。" />
  <section class="section container narrow discussion-layout">
    <div>
      <h2>讨论分类</h2>
      <div class="discussion-grid">{categories.map((category, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{category}</h3></article>)}</div>
    </div>
    <aside class="discussion-callout">
      <p class="eyebrow">GITHUB DISCUSSIONS</p><h2>进入论坛讨论区</h2>
      <p>GitHub Discussions 便于长期保存公开讨论、搜索历史问题，并与每期活动页面的 giscus 评论互通。</p>
      {community.discussionsUrl ? <a class="button" href={community.discussionsUrl}>进入讨论区</a> : <p class="muted">仓库确定并启用 Discussions 后，入口会自动生效。</p>}
    </aside>
  </section>
</BaseLayout>
