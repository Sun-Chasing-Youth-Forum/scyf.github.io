---
import type { CollectionEntry } from 'astro:content';
import { formatDate, effectiveStatus } from '../utils/events';
import { sitePath } from '../utils/paths';
import StatusBadge from './StatusBadge.astro';

interface Props { event: CollectionEntry<'events'>; compact?: boolean; }
const { event, compact = false } = Astro.props;
const speakers = event.data.sessions.length
  ? event.data.sessions.map((session) => session.speaker).join('、')
  : (event.data.speaker || '待定');
const affiliations = event.data.sessions.length
  ? [...new Set(event.data.sessions.map((session) => session.affiliation).filter(Boolean))].join('、') || '待定'
  : (event.data.affiliation || '待定');
const titles = event.data.sessions.length
  ? event.data.sessions.map((session) => session.title).join('；')
  : (event.data.title || '报告题目待更新');
---
<article class:list={['event-card', { compact }] }>
  <div class="event-card-top">
    <p>第 {event.data.issue} 期</p>
    <StatusBadge status={effectiveStatus(event.data)} />
  </div>
  <p class="event-card-date">{formatDate(event.data.date)} · {event.data.time}</p>
  <h3><a href={sitePath(`/events/${event.id}/`)}>{titles}</a></h3>
  <dl>
    <div><dt>主持人</dt><dd>{event.data.host}</dd></div>
    <div><dt>报告人</dt><dd>{speakers}</dd></div>
    <div><dt>单位</dt><dd>{affiliations}</dd></div>
  </dl>
  <a class="card-link" href={sitePath(`/events/${event.id}/`)}>查看详情 <span aria-hidden="true">→</span></a>
</article>
