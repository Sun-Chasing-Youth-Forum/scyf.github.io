# Organization Pages 仓库全名
PUBLIC_GITHUB_REPOSITORY=Sun-Chasing-Youth-Forum/sun-chasing-youth-forum.github.io

# 在 https://giscus.app/zh-CN 获取以下参数
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=活动讨论
PUBLIC_GISCUS_CATEGORY_ID=

# 可选：论坛公开联系邮箱
PUBLIC_CONTACT_EMAIL=

# 可选：自定义域名完整地址，例如 https://forum.example.org
SITE_URL=

# 可选：通常无需填写；GitHub Actions 会根据仓库名称自动决定
BASE_PATH=
