{
  "name": "scyf-website-manager",
  "productName": "SCYF Website Manager",
  "version": "0.1.1",
  "description": "逐日青年论坛网站管理器",
  "author": "Sun-Chasing Youth Forum",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "icons": "node scripts/icons.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:win": "electron-builder --win zip --x64 --publish never",
    "pack:mac": "electron-builder --mac zip --publish never"
  },
  "dependencies": { "yaml": "2.9.1" },
  "devDependencies": { "electron": "44.4.5", "electron-builder": "26.15.3" },
  "build": {
    "appId": "org.scyf.website-manager",
    "directories": { "output": "release" },
    "files": ["desktop/**", "core/**", "ui/**", "assets/icon.png", "app-config.json", "package.json"],
    "extraFiles": [{ "from": "README.md", "to": "使用说明.md" }],
    "artifactName": "SCYF-Manager-${version}-${os}-${arch}.${ext}",
    "win": { "target": "zip", "icon": "assets/icon.ico", "signExecutable": false },
    "mac": { "target": "zip", "icon": "assets/icon.icns", "category": "public.app-category.productivity", "identity": null },
    "asar": true
  }
}
